//Arduino Uno R3
//ldr on pin A0
#define led 13
void setup() {
  // put your setup code here, to run once:
  pinMode(led, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  // put your main code here, to run repeatedly:
  int ldr = analogRead(0);
  if (ldr > 200) {
    digitalWrite(led, HIGH);
  } else {
    digitalWrite(led, HIGH);
  }
}
